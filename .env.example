# Copy to .env for local development. Docker compose reads this too.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hydrox:hydrox@localhost:5432/hydrox
REDIS_URL=redis://localhost:6379
# Random 32+ char string; signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# Public origin the app is served from (used for setup links).
APP_ORIGIN=http://localhost:3000
TZ=America/Toronto
