{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hydrox 45 API (Fastify 5 + Kysely + Postgres)",
  "engines": { "node": ">=22" },
  "files": ["dist", "migrations", "seed"],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "setup-link": "tsx src/cli/setup-link.ts",
    "gen-vapid": "tsx src/cli/gen-vapid.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "bullmq": "^6.3.11",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.2",
    "ioredis": "^6.0.0",
    "kysely": "^0.28.2",
    "pg": "^8.14.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
