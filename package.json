{
  "name": "hydrox45",
  "private": true,
  "version": "0.1.0",
  "description": "Hydrox 45 — a two-person accountability app for a 45-day challenge",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter api migrate",
    "seed": "pnpm --filter api seed",
    "setup-link": "pnpm --filter api setup-link"
  }
}
